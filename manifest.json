{
    "manifest_version": 3,
    "name": "UGC Job Board Assistant",
    "version": "1.0",
    "description": "Scrapes job info from platforms like Vidsy, Twirl, and Billo to help UGC creators.",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["<all_urls>"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
